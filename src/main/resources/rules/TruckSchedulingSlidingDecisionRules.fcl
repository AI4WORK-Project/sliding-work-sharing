FUNCTION_BLOCK truckSchedulingSlidingDecisionRules	// Block definition (there may be more than one block per file)

VAR_INPUT				// Define input variables
	positionOfTruckToBePrioritized : REAL;
	materialUrgency : REAL;
END_VAR

VAR_OUTPUT				// Define output variable
	suggestedApproach : REAL;
END_VAR

FUZZIFY positionOfTruckToBePrioritized
	TERM nearFrontOfTheQueue := (5, 1) (10, 0); // near front of the queue from 0 to 5 trucks, gradually decreasing to 10 trucks
END_FUZZIFY

FUZZIFY materialUrgency // in hours until the material is needed
    TERM critical := (2, 1) (4, 0); // critical from 0 to 2 hours, gradually decrease to 4 hours
    TERM moderate := (2, 0) (4, 1); // moderate from 10 to 4, gradually decreases from 4 to 2
END_FUZZIFY

DEFUZZIFY suggestedApproach
	TERM autonomousReprioritization := 1; // 1 = autonomous reprioritization
	TERM requireHumanApproval := 2;       // 2 = require human approval

	METHOD : COGS;		// Use 'Center Of Gravity' defuzzification method
	DEFAULT := 2;		// Default value IS 2 (requireHumanApproval if no rule activates defuzzifier)
END_DEFUZZIFY

RULEBLOCK No1
	AND : MIN;			// Use 'min' for 'and' (also implicit use 'max' for 'or' to fulfill DeMorgan's Law)

	RULE A : IF positionOfTruckToBePrioritized IS nearFrontOfTheQueue
	            AND materialUrgency IS critical
	                THEN suggestedApproach IS autonomousReprioritization;
	RULE B : IF positionOfTruckToBePrioritized IS NOT nearFrontOfTheQueue
	            AND materialUrgency IS moderate
	                THEN suggestedApproach IS requireHumanApproval;;

END_RULEBLOCK

END_FUNCTION_BLOCK
